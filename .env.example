# --- chat 模型（OpenAI 兼容：OpenAI / x.ai grok / 智谱 glm / ...）---
OPENAI_API_KEY=sk-...
# 指向兼容网关；用真正的 OpenAI 就留空 / 不填。
OPENAI_BASE_URL=https://api.x.ai/v1
RAG_MODEL=grok-4.5
# 裁判模型（LLM-as-judge）。**不填则同 RAG_MODEL**。
# 做模型对比时务必把它**固定住**：换答题模型用 `eval_agentic.py --model <名>`，裁判端别动——
# 否则等于同时换掉被测对象和尺子，分数不可比（见 EXPERIMENTS 实验13）。
# RAG_JUDGE_MODEL=deepseek-v4-pro-nothinking

# 抵抗网关抖动：某些网关 WAF 拦未知 UA -> 伪装一个；5xx/超时 -> 多重试几次。
# RAG_USER_AGENT=claude-code/2.1.214
# RAG_MAX_RETRIES=5
# RAG_TIMEOUT=120

# --- 检索配置的整体开关（**默认值写在代码里**，这里只在做 A/B 时临时覆盖）---
# 现行默认：chunk=600 / overlap=150 / pool=200 / k=32，选型过程见 EXPERIMENTS 实验 19-21。
# 想复现旧配置做对照，**不必改代码**，在命令前加环境变量即可：
#   RAG_CHUNK_SIZE=1200 RAG_POOL=100 RAG_TOPK=16 python eval_agentic.py ...
# ⚠️ 改 chunk 会换一份 embedding 缓存与 Chroma 集合（按语料指纹命名），首次会重新编码几分钟。
# RAG_CHUNK_SIZE=600
# RAG_CHUNK_OVERLAP=150
# RAG_POOL=200
# RAG_TOPK=32

# --- LangSmith 追踪 + 评测（eval_rag.py --upload）---
# ⚠️ 免费额度是**每月唯一 trace 数**，跑几轮 agentic 评测就会触顶，之后每次调用都往 stderr 刷
#    `429 ... Monthly unique traces usage limit exceeded`（读数据集、建实验仍正常，只是 run 存不进去）。
#    确定性诊断脚本（eval_rebuild.py / eval_chain.py / eval_diag.py）本来就不需要追踪，
#    额度紧张时直接关掉：LANGSMITH_TRACING=false
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=agentic-rag
