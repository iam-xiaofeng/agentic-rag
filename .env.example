# 复制成 .env 填真实值（.env 已 gitignore）。
#
# ⚠️ **模型凭据不在这里** —— 在 `endpoints.json`（模型名 → base_url + api_key 的注册表，
#    同样已 gitignore，模板见 endpoints.example.json）。
#    原因：旧版「一个 OPENAI_BASE_URL + 一把 OPENAI_API_KEY」的全局单例假设，在做**多模型对照**
#    时会塌（两个臂分属两个网关、两把 key），而且 dump 里不记模型名 → 事后无法判定某个 jsonl
#    是谁跑的。注册表让「模型名」成为唯一入口，`rag/runctx.py` 把它记进每个 run 的 __meta__。

# ── 网关行为（与模型无关）──
# 某些中转网关的 WAF 会拦未知 User-Agent，伪装一个即可
RAG_USER_AGENT=claude-code/2.1.214
# 抵抗网关偶发 5xx / 超时（如 Cloudflare 524：源站 120s 没返回）
RAG_MAX_RETRIES=5
# 进程级限流（每秒请求数）。**这是治 429 的正确工具** —— 429 的含义是"你发太快了"，
# 解法是发慢点、不是重试更狠（任务级重试会把整题重发，反而放大负载）。缺省不开。
# RAG_RPS=1.0
RAG_TIMEOUT=180

# ── 答题 / 裁判模型（可选；不设则用 endpoints.json 的 _roles）──
# **裁判必须固定**：换裁判 = 换尺子，新旧分数不可比（实验13）。
# 换答题模型走 `--model <名>` 或 run_matrix.py 的 `model=` 臂参数，裁判端别动。
# RAG_MODEL=deepseek-v4-pro
# RAG_JUDGE_MODEL=deepseek-v4-pro-nothinking

# ── 检索栈旋钮（默认值写在代码里，这里只在做 A/B 时覆盖）──
# 现行定档：chunk=600 / overlap=150 / pool=200 / k=32，选型过程见 EXPERIMENTS 实验 19-21。
# run_matrix.py 的臂参数（topk= / pool= / decompose= / agent=）走的就是这几个变量。
# ⚠️ 改 chunk 会换一份 embedding 缓存与 Chroma 集合（按语料指纹命名），首次会重新编码几分钟。
# ⚠️ chunk 只能在**进程启动前**设：语料一个进程只加载一次，同进程内的多个臂改不动它。
# RAG_TOPK=8               # 实验27：32→8 覆盖不变而上下文省 2/3（**仅在真桥接数据集上成立**）
# RAG_POOL=200             # pool×chunk ≈ 恒定（实验19⑥）；只涨池覆盖不改前排顺序 = 不会变成交付
# RAG_CHUNK_SIZE=600
# RAG_CHUNK_OVERLAP=150
# RAG_DECOMPOSE=1          # 分解 → 逐子问句各自重排（默认关，见 rag/retriever_decompose.py）
# RAG_AGENT=planner        # 控制流：react（默认，模型自定）| planner（多跳由代码保证）
# RAG_MAX_HOPS=5           # planner 的最大跳数

# ── MuSiQue（默认评测集，走 HuggingFace 缓存 ~/.cache/huggingface）──
# MUSIQUE_SPLIT=validation

# ── LangSmith（可选；现行评测路径**全程不依赖它**）──
# 免费额度是每月唯一 trace 数，跑几轮 agentic 评测就会触顶。确定性诊断脚本本来也不需要它。
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=agentic-rag
